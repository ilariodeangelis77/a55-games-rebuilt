# Never commit the firmware dump (contains IMEI/EEPROM data) or anything derived 1:1 from it
firmware/
*.bin
*.fls
*.ff

# Local toolchain (Ghidra install, downloads)
tools/

# Ghidra project databases
*.gpr
*.rep/
*.lock
*.lock~
ghidra_projects/

# Bulk/intermediate output stays local (logs, Ghidra projects, decrypted payloads, scratch C).
# Only the extracted game data the web pages load is published: out/<game>/*.json (+ the XSB levels).
out/*
!out/games/
!out/mtb/
!out/wacko/
!out/balloon/
!out/stack/
out/*/*
!out/*/*.json
!out/mtb/levels.xsb

__pycache__/
*.pyc
